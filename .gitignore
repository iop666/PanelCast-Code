# Copyright material (source books) and derived local outputs
この素晴らしい世界に祝福を！/
*.epub
*.mobi

# M0 experiment: copied manga pages, novel excerpts, model drafts stay local.
# Only the prompt templates / result table / alignment note are tracked.
m0/pages/
m0/novel_excerpt.txt
m0/drafts/

# M1 workspace: copied pages, synthesized audio and render scratch stay local.
# Tracked: capability_report.md, panels/*.json, script.json, timeline.json.
m1/work/pages/
m1/work/audio/
m1/work/cache/
# 5-minute review build: same policy (script.json + panels tracked, media local)
m1/test5min/work/pages/
m1/test5min/work/audio/
m1/test5min/work/cache/
m1/test5min/out/
# 第一章成片（按章节出片）：同上
m1/ch1/work/pages/
m1/ch1/work/audio/
m1/ch1/work/cache/
m1/ch1/out/

# Local pipeline artifacts
.local/

# Agent workspace (local notes, memory, tool state)
.workbuddy-ai/

# Python
__pycache__/
*.py[cod]
.venv/
.env

# Build / render outputs
out/
renders/
dist/
*.mp4
m1/v*/work/pages/
m1/v*/work/profiles/
m1/v*/work/cache/
m1/v*/work/audio/
m1/v*/out/
# 章级 work 目录（m1/v1/ch02/work/...）：页面、音频、帧缓存、成片都不入库
m1/**/work/pages/
m1/**/work/audio/
m1/**/work/cache/
# 章级 panels 是 --skip-panel-gate 留下的整页占位框，没有信息量；只有 m1/work/panels
# 里的自动检测结果（含人工修正）值得入库，所以下面一行把那个目录挖回来。
m1/**/work/panels/
!m1/work/panels/
m1/**/out/
